{
  "name": "axelus-sdk",
  "version": "1.0.0",
  "description": "AXELUS-WAF Node.js/TypeScript SDK — License validation and feature gating",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build":       "tsc && tsc -p tsconfig.esm.json",
    "test":        "jest --coverage",
    "test:watch":  "jest --watch",
    "lint":        "eslint src/**/*.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["waf", "firewall", "security", "license", "axelus", "optimium-nexus"],
  "author": {
    "name":  "OPTIMIUM NEXUS LLC",
    "email": "contact@optimiumnexus.com",
    "url":   "https://www.optimiumnexus.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url":  "https://github.com/optimiumnexusllc/axelus-waf.git",
    "directory": "sdk/nodejs"
  },
  "homepage": "https://www.optimiumnexus.com/docs/sdk/nodejs",
  "bugs":     "https://github.com/optimiumnexusllc/axelus-waf/issues",
  "devDependencies": {
    "@types/jest":    "^29.5.11",
    "@types/node":    "^20.11.5",
    "jest":           "^29.7.0",
    "ts-jest":        "^29.1.2",
    "typescript":     "^5.3.3"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": { "optional": true }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18.0.0" },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts"]
  }
}
