# ── Core ──────────────────────────────────────────────────────────────────────
IMAGE_PREFIX=optimiumnexusllc
IMAGE_TAG=latest
ARCH_SUFFIX=
REGION=
RELEASE=
SUBNET_PREFIX=172.22.222
SAFELINE_DIR=/data/axelus-waf
MGT_PORT=9443

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_32CHARS

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_256BIT_HEX_SECRET
ADMIN_API_KEY=CHANGE_ME_ADMIN_API_KEY
LICENSE_ADMIN_KEY=CHANGE_ME_LICENSE_ADMIN_KEY

# ── Threat Intelligence (optional) ───────────────────────────────────────────
THREAT_INTEL_ABUSEIPDB_KEY=
THREAT_INTEL_EMERGING_THREATS_KEY=
THREAT_INTEL_CUSTOM_FEEDS=

# ── SIEM (optional) ───────────────────────────────────────────────────────────
SIEM_ELASTICSEARCH_URL=
SIEM_SPLUNK_HEC_URL=
SIEM_SPLUNK_TOKEN=

# ── Stripe Billing (optional) ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── SMTP Notifications (optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@optimiumnexus.com

# ── Alerting (optional) ───────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=

# ── MaxMind GeoIP2 (optional) ─────────────────────────────────────────────────
MAXMIND_LICENSE_KEY=
