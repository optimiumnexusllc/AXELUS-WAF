# =============================================================================
# IronWall - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ── CORE ─────────────────────────────────────────────────────────────────────
IMAGE_PREFIX=chaitin
IMAGE_TAG=latest
ARCH_SUFFIX=
REGION=
RELEASE=
SUBNET_PREFIX=172.22.222
SAFELINE_DIR=/data/ironwall
MGT_PORT=9443

# ── DATABASE ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── REDIS (Premium) ──────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── THREAT INTELLIGENCE (Premium) ────────────────────────────────────────────
# AbuseIPDB API key — https://www.abuseipdb.com/account/api
THREAT_INTEL_ABUSEIPDB_KEY=

# Emerging Threats (Proofpoint) — https://rules.emergingthreats.net/
THREAT_INTEL_EMERGING_THREATS_KEY=

# Custom feed URLs (comma-separated, plain text IP list format)
THREAT_INTEL_CUSTOM_FEEDS=

# Update interval in seconds (default: 3600 = 1 hour)
THREAT_INTEL_UPDATE_INTERVAL=3600

# ── GEOIP (Premium) ──────────────────────────────────────────────────────────
# MaxMind GeoIP2 license key — https://www.maxmind.com/en/accounts/
GEOIP_MAXMIND_LICENSE_KEY=
GEOIP_MAXMIND_ACCOUNT_ID=

# ── ALERTING (Premium) ────────────────────────────────────────────────────────
# Severity threshold: low | medium | high | critical
ALERT_THRESHOLD_SEVERITY=high

# Slack
ALERT_SLACK_WEBHOOK=
ALERT_SLACK_CHANNEL=#security-alerts

# Microsoft Teams
ALERT_TEAMS_WEBHOOK=

# PagerDuty
ALERT_PAGERDUTY_INTEGRATION_KEY=

# Email (SMTP)
ALERT_SMTP_HOST=smtp.example.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM=ironwall@example.com
ALERT_SMTP_TO=security@example.com

# ── SIEM (Premium) ────────────────────────────────────────────────────────────
# Elasticsearch / OpenSearch
SIEM_ELASTICSEARCH_URL=
SIEM_ELASTICSEARCH_USER=
SIEM_ELASTICSEARCH_PASSWORD=
SIEM_ELASTICSEARCH_INDEX=ironwall-logs

# Splunk HEC
SIEM_SPLUNK_HEC_URL=
SIEM_SPLUNK_HEC_TOKEN=
SIEM_SPLUNK_INDEX=ironwall

# Grafana Loki
SIEM_LOKI_URL=

# ── MONITORING ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=30d

# ── COMPLIANCE (Premium) ──────────────────────────────────────────────────────
# Schedule for automated compliance report generation (cron format)
COMPLIANCE_REPORT_SCHEDULE=0 6 * * 1
COMPLIANCE_REPORT_RECIPIENTS=compliance@example.com
